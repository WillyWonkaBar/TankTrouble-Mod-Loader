{
  "manifest_version": 3,
  "name": "TankTrouble Mod Loader",
  "version": "2.0",
   "icons": {
    "128": "assets/icon.png"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "TTOverride",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
	"storage"
  ],
  "host_permissions": [
    "https://tanktrouble.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/TTOverride.js",
		"index.html"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tanktrouble.com/*"
      ],
      "js": [
        "scripts/loader.js"
      ],
	  "world": "MAIN",
	  "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tanktrouble.com/*"
      ],
      "js": [
        "scripts/interceptor.js"
      ],
	  "world": "ISOLATED",
	  "run_at": "document_idle"
    }
  ],
  "background": {
	"scripts": ["background.js"]
  }
}