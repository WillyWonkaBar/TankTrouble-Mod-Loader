{
  "manifest_version": 3,
  "name": "TankTrouble Mod Loader",
  "description": "A simple mod loader for the TankTrouble game",
  "version": "3.0",
   "icons": {
    "128": "assets/icon.png"
  },
  
  "action": {
    "default_title": "Open mod manager"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "TTOverride",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
	"storage",
	"tabs"
  ],
  "host_permissions": [
    "https://tanktrouble.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/TTOverride.js",
		"index.html"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tanktrouble.com/*"
      ],
      "js": [
        "scripts/loader.js"
      ],
	  "world": "MAIN",
	  "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tanktrouble.com/*"
      ],
      "js": [
        "scripts/interceptor.js"
      ],
	  "world": "ISOLATED",
	  "run_at": "document_idle"
    }
  ],
  "background": {
	"service_worker": "background.js",
	"scripts": ["background.js"]
  },
  "browser_specific_settings": {
	 "gecko": {
		 "id": "@WillyWonkaBar-TankTroubleModLoader",
		 "data_collection_permissions": {
		"required": [
          "none"
		]
      }
	}
  }
}